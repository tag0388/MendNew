# ---------------------------------------------------------------- Supabase --
# Project: "Mend Cost Management" (ap-southeast-2)
# Find these under Project Settings -> API in the Supabase dashboard.
#
# The publishable key is meant to be shipped in the browser bundle -- it grants
# nothing on its own. Every table is protected by row level security, so what a
# request can read or write is decided by the signed-in user's membership.
# Never put the service_role key in this file: it bypasses RLS entirely.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"

# RESEND_API_KEY: server-side only, for sending invitation emails.
# Get your key at https://resend.com/
RESEND_API_KEY=

# APP_URL: where this app is hosted. Used for invitation links.
APP_URL="http://localhost:3000"
